---
import CardLayout from '../layouts/CardLayout.astro';
import { routes } from '../i18n/config';

const pageTitle = 'Burak Can Kahraman | Dijital İletişim Kartı';
const pageDescription =
  'Burak Can Kahraman ile web tasarım, e-ticaret, randevu uygulamaları ve özel yazılım çözümleri için iletişime geçin.';
const canonicalURL = 'https://burakcankahraman-web.vercel.app/kart';

const contactLinks = [
  {
    label: "WhatsApp'tan İletişime Geç",
    ariaLabel: "Burak Can Kahraman'a WhatsApp üzerinden mesaj gönder",
    href: 'https://wa.me/905534145795',
    icon: 'whatsapp',
  },
  {
    label: 'Instagram Profilimi Gör',
    ariaLabel: "Burak Can Kahraman'ın Instagram profilini aç",
    href: 'https://www.instagram.com/burakckahraman/',
    icon: 'instagram',
  },
  {
    label: 'Web Sitemi Ziyaret Et',
    ariaLabel: "Burak Can Kahraman'ın web sitesini aç",
    href: routes.tr.home,
    icon: 'website',
  },
] as const;

const currentYear = new Date().getFullYear();
---

<CardLayout title={pageTitle} description={pageDescription} canonicalURL={canonicalURL}>
  <main class="flex min-h-screen items-center justify-center px-4 py-8 sm:px-6 sm:py-12">
    <article
      aria-labelledby="card-title"
      class="w-full max-w-md overflow-hidden border border-[#171713] bg-[#fffdf7] shadow-[8px_8px_0_#171713] sm:shadow-[12px_12px_0_#171713]"
    >
      <header class="border-b border-[#171713] px-5 py-6 sm:px-8 sm:py-8">
        <a
          href={routes.tr.home}
          aria-label="Burak Can Kahraman ana sayfasına git"
          class="group inline-flex items-center gap-3 font-mono text-sm font-bold tracking-[-0.04em] text-[#171713] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f4511e]"
        >
          <span
            aria-hidden="true"
            class="flex size-9 items-center justify-center bg-[#171713] text-[11px] text-[#f3f0e8] transition-transform duration-200 group-hover:-rotate-6"
          >BCK</span>
          <span>BURAK CAN <span class="text-[#f4511e]">KAHRAMAN</span></span>
        </a>

        <p class="mt-8 font-mono text-sm font-bold tracking-[0.13em] text-[#f4511e] uppercase">
          Web Tasarım &amp; Yazılım Çözümleri
        </p>
        <h1 id="card-title" class="mt-3 text-4xl leading-[0.95] font-black tracking-[-0.055em] text-[#171713] sm:text-5xl">
          Fikrinizi çalışan bir dijital ürüne dönüştürelim.
        </h1>
        <p class="mt-5 text-base leading-7 text-[#65645d]">
          Web sitesi, e-ticaret ve randevu uygulamaları için sade, hızlı ve işinize özel çözümler geliştiriyorum.
        </p>
      </header>

      <section class="px-5 py-6 sm:px-8 sm:py-8" aria-labelledby="contact-options-title">
        <h2 id="contact-options-title" class="font-mono text-sm font-bold tracking-[0.14em] text-[#65645d] uppercase">
          İletişim seçenekleri
        </h2>

        <ul class="mt-4 space-y-3" role="list">
          {
            contactLinks.map((link, index) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.ariaLabel}
                  class:list={[
                    'group flex min-h-14 w-full items-center gap-4 border border-[#171713] px-4 py-3.5 text-base font-bold transition duration-200 motion-safe:hover:-translate-y-0.5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#f4511e] active:translate-y-0',
                    index === 0
                      ? 'bg-[#171713] text-[#f3f0e8] hover:bg-[#f4511e]'
                      : 'bg-[#f3f0e8] text-[#171713] hover:bg-[#f4511e] hover:text-white',
                  ]}
                >
                  <span
                    aria-hidden="true"
                    class:list={[
                      'flex size-10 shrink-0 items-center justify-center border transition-colors',
                      index === 0
                        ? 'border-[#f3f0e8]/40 bg-[#f3f0e8] text-[#171713]'
                        : 'border-[#171713] bg-[#fffdf7] text-[#171713]',
                    ]}
                  >
                    {link.icon === 'whatsapp' && (
                      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.4L3.5 20.5l1.4-4.2a8.4 8.4 0 1 1 15.5-4.6Z" />
                        <path d="M8.2 7.8c.2-.4.4-.4.7-.4h.4c.2 0 .3.1.4.4l.8 1.8c.1.2 0 .4-.1.6l-.6.7c-.1.1-.2.3-.1.5.5 1.1 1.4 2 2.5 2.5.2.1.4 0 .5-.1l.8-1c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.4 0 .2-.1 1.2-.7 1.8-.5.6-1.4.9-2.3.7-1.2-.3-2.6-1-4-2.2-1.1-1-2.1-2.4-2.5-3.7-.4-1.2 0-2.2.4-2.7l.9-.1Z" />
                      </svg>
                    )}
                    {link.icon === 'instagram' && (
                      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
                      </svg>
                    )}
                    {link.icon === 'website' && (
                      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3.5 9h17M3.5 15h17M12 3c2.1 2.3 3.2 5.3 3 9 .2 3.7-.9 6.7-3 9-2.1-2.3-3.2-5.3-3-9-.2-3.7.9-6.7 3-9Z" />
                      </svg>
                    )}
                  </span>
                  <span class="min-w-0">{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="border-t border-[#cfcbc0] bg-[#f3f0e8] px-5 py-6 sm:px-8" aria-labelledby="share-title">
        <div class="grid items-center gap-5 min-[380px]:grid-cols-[104px_1fr]">
          <img
            src="/qr/burak-can-kahraman-kart.svg"
            width="104"
            height="104"
            alt="Bu dijital iletişim kartını açan QR kod"
            class="size-26 border border-[#cfcbc0] bg-white p-1"
            loading="eager"
          />
          <div class="min-w-0">
            <h2 id="share-title" class="text-lg font-black tracking-[-0.025em] text-[#171713]">Kartı paylaş</h2>
            <p class="mt-1 text-sm leading-5 text-[#65645d]">Baskı ve dijital kullanım için yüksek kaliteli QR kodunu indir.</p>
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 font-mono text-sm font-bold">
              <a
                href="/qr/burak-can-kahraman-kart.svg"
                download
                class="underline decoration-[#f4511e] decoration-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#f4511e]"
              >SVG indir</a>
              <a
                href="/qr/burak-can-kahraman-kart.png"
                download
                class="underline decoration-[#f4511e] decoration-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#f4511e]"
              >PNG indir</a>
            </div>
          </div>
        </div>
      </section>

      <footer class="border-t border-[#171713] bg-[#171713] px-5 py-4 text-center font-mono text-sm text-[#aaa79d] sm:px-8">
        &copy; {currentYear} Burak Can Kahraman
      </footer>
    </article>
  </main>
</CardLayout>
