---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { routes, ui, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = ui[lang].home;
---

<BaseLayout lang={lang} routeKey="home" title={copy.title} description={copy.description}>
  <div class="space-y-24 lg:space-y-32">
    <section class="grid gap-12 border-b border-[#171713] pb-16 lg:grid-cols-[1.45fr_0.55fr] lg:items-end lg:pb-24" aria-labelledby="hero-title">
      <div>
        <div class="mb-8 flex items-center gap-3 font-mono text-[11px] font-bold tracking-[0.18em] uppercase">
          <span class="h-px w-10 bg-[#f4511e]"></span>
          {copy.eyebrow}
        </div>
        <h1 id="hero-title" class="max-w-4xl text-[clamp(3.2rem,8vw,7rem)] leading-[0.88] font-black tracking-[-0.075em] text-[#171713]">
          {copy.titleBefore} <span class="text-[#f4511e]">{copy.titleHighlight}</span> {copy.titleAfter}
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-[#65645d] sm:text-xl">{copy.intro}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={routes[lang].contact} class="bg-[#171713] px-5 py-3 font-mono text-xs font-bold tracking-wider text-[#f3f0e8] uppercase transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#171713]">
            {copy.primaryCta}
          </a>
          <a href={routes[lang].projects} class="border border-[#171713] px-5 py-3 font-mono text-xs font-bold tracking-wider text-[#171713] uppercase transition-colors hover:bg-[#f4511e] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#171713]">
            {copy.secondaryCta}
          </a>
        </div>
      </div>

      <aside class="border-l border-[#171713] pl-6 font-mono text-xs" aria-label={copy.statusLabel}>
        <p class="text-[10px] tracking-[0.18em] text-[#65645d] uppercase">{copy.statusLabel}</p>
        <p class="mt-3 flex items-center gap-2 text-sm font-bold">
          <span class="size-2 rounded-full bg-[#f4511e]"></span>{copy.status}
        </p>
        <dl class="mt-8 space-y-3 border-t border-[#cfcbc0] pt-4 text-[#65645d]">
          {copy.facts.map(([term, value]) => (
            <div class="flex justify-between gap-4"><dt>{term}</dt><dd class="text-[#171713]">{value}</dd></div>
          ))}
        </dl>
      </aside>
    </section>

    <section aria-labelledby="solutions-title">
      <div class="grid gap-8 lg:grid-cols-[0.6fr_1.4fr]">
        <div>
          <p class="font-mono text-[10px] font-bold tracking-[0.18em] text-[#f4511e] uppercase">{copy.solutionsEyebrow}</p>
          <h2 id="solutions-title" class="mt-2 text-3xl font-black tracking-[-0.04em] text-[#171713] sm:text-4xl">{copy.solutionsTitle}</h2>
        </div>
        <div class="divide-y divide-[#171713] border-y border-[#171713]">
          {copy.solutions.map((solution, index) => (
            <article class="group grid gap-3 py-6 sm:grid-cols-[2rem_0.75fr_1.25fr_auto] sm:items-start">
              <span class="font-mono text-xs text-[#f4511e]">0{index + 1}</span>
              <h3 class="font-bold text-[#171713]">{solution.title}</h3>
              <p class="text-sm leading-6 text-[#65645d]">{solution.description}</p>
              <a href={`${routes[lang].services}#${solution.anchor}`} class="font-mono text-xs font-bold text-[#171713] underline decoration-[#f4511e] decoration-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#171713]">
                {copy.solutionLink}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="featured-projects-title">
      <div class="mb-8 flex items-end justify-between gap-6 border-b border-[#171713] pb-4">
        <div>
          <p class="font-mono text-[10px] font-bold tracking-[0.18em] text-[#f4511e] uppercase">{copy.projectsEyebrow}</p>
          <h2 id="featured-projects-title" class="mt-2 text-3xl font-black tracking-[-0.04em] text-[#171713] sm:text-4xl">{copy.projectsTitle}</h2>
        </div>
        <a href={routes[lang].projects} class="hidden font-mono text-xs font-bold text-[#171713] underline decoration-[#f4511e] decoration-2 underline-offset-4 sm:block">{copy.allProjects}</a>
      </div>
      <div>
        {copy.projects.map((project, index) => (
          <article class="group grid gap-5 border-b border-[#cfcbc0] py-7 sm:grid-cols-[3rem_1fr_auto] sm:items-start">
            <span class="font-mono text-xs font-bold text-[#f4511e]">0{index + 1}</span>
            <div>
              <p class="mb-2 font-mono text-[10px] font-bold tracking-wider text-[#65645d] uppercase">{project.type}</p>
              <h3 class="text-2xl font-bold tracking-[-0.035em] text-[#171713] transition-transform group-hover:translate-x-2">{project.title}</h3>
              <p class="mt-2 max-w-xl leading-7 text-[#65645d]">{project.description}</p>
            </div>
            <ul class="flex flex-wrap gap-2 sm:justify-end" aria-label={`${project.title} technologies`}>
              {project.technologies.map((technology) => (
                <li class="border border-[#cfcbc0] px-2 py-1 font-mono text-[10px] font-bold text-[#65645d] uppercase">{technology}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="process-title">
      <div class="mb-8 max-w-2xl">
        <p class="font-mono text-[10px] font-bold tracking-[0.18em] text-[#f4511e] uppercase">{copy.processEyebrow}</p>
        <h2 id="process-title" class="mt-2 text-3xl font-black tracking-[-0.04em] text-[#171713] sm:text-4xl">{copy.processTitle}</h2>
      </div>
      <ol class="grid gap-px border border-[#171713] bg-[#171713] sm:grid-cols-2 lg:grid-cols-4">
        {copy.process.map(([title, description], index) => (
          <li class="flex min-h-64 flex-col bg-[#f3f0e8] p-6">
            <span class="font-mono text-xs font-bold text-[#f4511e]">0{index + 1}</span>
            <h3 class="mt-10 text-xl font-bold tracking-[-0.035em] text-[#171713]">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-[#65645d]">{description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="contact-cta-title">
      <div class="relative overflow-hidden bg-[#f4511e] p-7 text-white sm:p-10">
        <span class="absolute -top-7 right-3 font-mono text-[8rem] leading-none font-black text-white/10" aria-hidden="true">BCK</span>
        <p class="font-mono text-[10px] font-bold tracking-[0.18em] uppercase">{copy.ctaEyebrow}</p>
        <h2 id="contact-cta-title" class="relative mt-6 max-w-2xl text-3xl font-black tracking-[-0.045em] sm:text-5xl">{copy.ctaTitle}</h2>
        <p class="relative mt-5 max-w-2xl leading-7 text-white/85">{copy.ctaDescription}</p>
        <a href={routes[lang].contact} class="relative mt-8 inline-block bg-[#171713] px-5 py-3 font-mono text-xs font-bold tracking-wider text-[#f3f0e8] uppercase transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white">{copy.ctaButton}</a>
      </div>
    </section>
  </div>
</BaseLayout>
