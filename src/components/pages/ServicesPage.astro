---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { routes, ui, type Lang } from '../../i18n/config';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = ui[lang].services;
---

<BaseLayout lang={lang} routeKey="services" title={copy.title} description={copy.description}>
  <section aria-labelledby="services-title">
    <header class="grid gap-6 border-b border-[#171713] pb-10 sm:grid-cols-[1fr_1.2fr] sm:items-end">
      <div>
        <p class="font-mono text-[10px] font-bold tracking-[0.18em] text-[#f4511e] uppercase">{copy.eyebrow}</p>
        <h1 id="services-title" class="mt-3 text-5xl leading-none font-black tracking-[-0.06em] text-[#171713] sm:text-7xl">{copy.heading}</h1>
      </div>
      <p class="max-w-xl text-lg leading-8 text-[#65645d]">{copy.intro}</p>
    </header>

    <div class="mt-12 grid border-t border-[#171713]">
      {copy.items.map((service, index) => (
        <article id={service.id} class="group grid scroll-mt-8 gap-5 border-b border-[#171713] py-8 sm:grid-cols-[5rem_1fr]">
          <span class="flex size-12 items-center justify-center border border-[#171713] font-mono text-xs font-bold text-[#f4511e] transition-colors group-hover:bg-[#f4511e] group-hover:text-white" aria-hidden="true">0{index + 1}</span>
          <div>
            <h2 class="text-2xl font-bold tracking-[-0.04em] text-[#171713]">{service.title}</h2>
            <p class="mt-3 max-w-2xl leading-7 text-[#65645d]">{service.description}</p>
            <ul class="mt-6 grid gap-2 font-mono text-[11px] font-bold text-[#65645d] uppercase sm:grid-cols-3" role="list">
              {service.details.map((detail) => <li class="border-l-2 border-[#f4511e] pl-3">{detail}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 border border-[#171713] bg-[#fffdf7] p-6 shadow-[8px_8px_0_#171713] sm:p-8">
      <p class="font-mono text-[10px] font-bold tracking-[0.18em] text-[#f4511e] uppercase">{copy.customEyebrow}</p>
      <div class="mt-4 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <h2 class="text-2xl font-bold tracking-[-0.04em] text-[#171713]">{copy.customTitle}</h2>
          <p class="mt-3 max-w-2xl leading-7 text-[#65645d]">{copy.customDescription}</p>
        </div>
        <a href={routes[lang].contact} class="bg-[#171713] px-5 py-3 font-mono text-xs font-bold tracking-wider text-[#f3f0e8] uppercase transition-transform hover:-translate-y-1">{copy.customButton}</a>
      </div>
    </div>
  </section>
</BaseLayout>
